@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>Learn How to Build a Website</h1>

<p>
    Every website you've ever seen was built by someone. In these parts you will learn
    how a website works and how they are built using HTML, CSS, C#, and Razor.
</p>

<h2>What you will learn</h2>
<ul>
    <li><strong>HTML</strong> - Is what goes onto the page</li>
    <li><strong>CSS</strong> - Controls how the page will look</li>
    <li><strong>C# and Razor</strong> - Makes the page do things</li>
</ul>

<h2>Parts</h2>
<ol>
    @foreach (var lesson in LessonData.All)
    {
        <li>
            <a href="@lesson.Page">@lesson.Title</a>
            <br />
            @lesson.Summary
        </li>
    }
</ol>

<p><a class="button" href="/Lessons/WhatIsAWebsite">Go To Part 1</a></p>