@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>Learn How to Build a Website</h1>

<p>
    Every website you have ever visited was built by a person. In these lessons you will learn
    how websites work and how to build your own using HTML, CSS, C#, and Razor.
</p>

<h2>What you will learn</h2>
<ul>
    <li><strong>HTML</strong> - what goes on the page</li>
    <li><strong>CSS</strong> - how the page looks</li>
    <li><strong>C# and Razor</strong> - how to make the page do things</li>
</ul>

<h2>Lessons</h2>
<ol>
    @foreach (var lesson in LessonData.All)
    {
        <li>
            <a href="@lesson.Page">@lesson.Title</a>
            <br />
            @lesson.Summary
        </li>
    }
</ol>

<p><a class="button" href="/Lessons/WhatIsAWebsite">Start Lesson 1</a></p>
