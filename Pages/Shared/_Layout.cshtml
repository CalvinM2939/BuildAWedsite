<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Build a Website</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <a class="site-name" href="/">Build a Website</a>
        <nav>
            <a href="/">Home</a>
            @foreach (var lesson in LessonData.All)
            {
                <a href="@lesson.Page">Part @lesson.Number</a>
            }
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>Made with HTML, CSS, C#, and Razor.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
